# This is a comment!
# Uncomment lines if you want to change them from their defaults

## web server
# WEB_PORT=80
# WEB_CORS=false
# WEB_SOCKET_TOKEN_PROTECTION=false

## management server
# WEB_MANAGEMENT_PORT=8898

## game server
# NODE_ID=10
# NODE_PORT=43594
# NODE_MEMBERS=true
# NODE_AUTO_SUBSCRIBE_MEMBERS=true
# NODE_XPRATE=1
# NODE_PROGRESSIVE_XP=false
# NODE_PROGRESSIVE_XP_SCALE=5
# NODE_PRODUCTION=false
# NODE_KILLTIMER=50
# NODE_DEBUG=true
# NODE_DEBUG_PROFILE=false
# NODE_DEBUG_SOCKET=false
# NODE_STAFF=pazaz
# NODE_CLIENT_ROUTEFINDER=true
# NODE_SOCKET_TIMEOUT=true
# NODE_WALKTRIGGER_SETTING=0
# NODE_PROFILE=main
# NODE_MAX_PLAYERS=2047
# NODE_MAX_NPCS=8191
# NODE_DEBUGPROC_CHAR=~

## login server
# LOGIN_SERVER=false
# LOGIN_HOST=localhost
# LOGIN_PORT=43500

## friend server
# FRIEND_SERVER=false
# FRIEND_HOST=localhost
# FRIEND_PORT=45099

## logger server
# LOGGER_SERVER=false
# LOGGER_HOST=localhost
# LOGGER_PORT=43501

## database
# DB_BACKEND=sqlite
# DATABASE_URL=mysql://root:password@localhost:3306/lostcity
# DB_HOST=localhost
# DB_NAME=lostcity
# DB_USER=root
# DB_PASS=password
# KYSELY_VERBOSE=false

## development
# BUILD_JAVA_PATH=java
# BUILD_STARTUP=true
# BUILD_STARTUP_UPDATE=true
# BUILD_VERIFY=true
# BUILD_VERIFY_FOLDER=true
# BUILD_VERIFY_PACK=true
# BUILD_SRC_DIR=data/src

## custom content
# NODE_FEATURE_CLANS=false
# NODE_FEATURE_CUSTOMSHOPS=false
# NODE_FEATURE_BOSSPETS=false
# NODE_FEATURE_CUSTOMWEAPONS=false
# NODE_FEATURE_SKILLCAPES=false
# NODE_FEATURE_XAMOUNT=false
# NODE_FEATURE_MAKEX=false
# NODE_QOL_MIDDLE_MOUSE_ROTATION=false
# NODE_QOL_COMPASS_RESET=false
# Option 2 only: true enables the plugin that stops automatic anti-macro camera rotation; false keeps vanilla rotation.
# NODE_QOL_ANTI_MACRO_ROTATION=false
# Option 2 only: true enables mouse scrollwheel camera zoom; options 1 and 3 force this false.
# NODE_QOL_SCROLLWHEEL_ZOOM=false

## launcher QOL
# Auto-open the webclient only after launcher option 2 (Custom Server + Hiscores) starts the custom server.
# NODE_QOL_AUTO_OPEN_WEBCLIENT=false
# Auto-open the hiscores page only for launcher option 2 using the main web server at /index.html (for example http://localhost/index.html on the default Windows WEB_PORT=80). When both auto-open flags are enabled, hiscores opens first and the webclient follows in the default browser session.
# NODE_QOL_AUTO_OPEN_HISCORES=false

## setup script
# WEBSITE_REGISTRATION=false
# EASY_STARTUP=false
