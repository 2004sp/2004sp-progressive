// r481 GE group 105 -> r254 IF1 overview geometry.
// Staged only by the Grand Exchange custom-content build.
// Positions and component sizes below are translated directly from the frozen r481 group-105 reference.

// Source component 0: 488x305 backing rect at (17,25). r481 used transparency=200;
// IF1 has no equivalent alpha field here, so retain the native dark backing approximation beneath the opaque tiled panel.
[com_0]
type=rect
x=17
y=25
width=488
height=305
fill=yes
colour=0x2E2B23

