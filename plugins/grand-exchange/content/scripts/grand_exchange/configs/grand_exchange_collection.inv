// r481 Grand Exchange collection/output containers.
// Source inventory IDs 523-528 map to option-2-only local IDs 158-163.
// Each offer slot can present up to two outputs (item/coins), so each
// compatibility container has two stackable slots.
//
// These remain temporary player containers. Confirming an offer immediately
// settles against the player's inventory and deposits the purchased items or
// sale proceeds here. Collection transfers those outputs into the real player
// inventory and releases the corresponding offer slot when it becomes empty.

[ge_collection_offer_0]
scope=temp
size=2
stackall=yes

[ge_collection_offer_1]
scope=temp
size=2
stackall=yes

[ge_collection_offer_2]
scope=temp
size=2
stackall=yes

[ge_collection_offer_3]
scope=temp
size=2
stackall=yes

[ge_collection_offer_4]
scope=temp
size=2
stackall=yes

[ge_collection_offer_5]
scope=temp
size=2
stackall=yes
