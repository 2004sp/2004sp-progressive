}
~ge_collection_refresh_offer_5;

// The card-level Collect action attempts both outputs, which is required for
// completed buy offers that expose purchased items and a price-difference refund.
[if_button,grand_exchange_group_109:com_61]
~ge_collection_collect_slot(ge_collection_offer_0, 0);
~ge_collection_collect_slot(ge_collection_offer_0, 1);
if (inv_getobj(ge_collection_offer_0, 0) ! null | inv_getobj(ge_collection_offer_0, 1) ! null) {
    mes("You don't have enough inventory space.");
}
~ge_collection_refresh_offer_0;

