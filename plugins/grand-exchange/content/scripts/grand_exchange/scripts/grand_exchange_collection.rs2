if_sethide(grand_exchange_group_109:com_81, true);

// Move as much of one collection-output slot as can safely fit in the player's
// inventory. inv_itemspace2 returns the amount that cannot fit, so any overflow
// remains in the GE source container for a later collection attempt.
[proc,ge_collection_collect_slot](inv $source, int $slot)
def_obj $item = inv_getobj($source, $slot);
if ($item = null) {
    return;
}
def_int $count = inv_getnum($source, $slot);
if ($count <= 0) {
    return;
}
def_int $overflow = inv_itemspace2(inv, $item, $count, inv_size(inv));
def_int $move_count = calc($count - $overflow);
if ($move_count <= 0) {
    return;
}
inv_moveitem($source, inv, $item, $move_count);

// After a collection attempt, collapse an offer card only when both outputs are
// exhausted. If one output remains (for example a buy item plus coin refund),
// keep the card usable and avoid stale fixture-specific quantity text.
[proc,ge_collection_refresh_offer_0]
if (inv_getobj(ge_collection_offer_0, 0) = null & inv_getobj(ge_collection_offer_0, 1) = null) {
    if_settext(grand_exchange_group_109:com_58, "Empty");
    if_settext(grand_exchange_group_109:com_60, "");
    if_settext(grand_exchange_group_109:com_61, "");
    if_sethide(grand_exchange_group_109:com_59, true);
    if_sethide(grand_exchange_group_109:com_60, true);
    if_sethide(grand_exchange_group_109:com_61, true);
    return;
}
if_settext(grand_exchange_group_109:com_58, "Collection");
if_settext(grand_exchange_group_109:com_60, "Items remaining");
if_settext(grand_exchange_group_109:com_61, "Collect");
if_sethide(grand_exchange_group_109:com_59, false);
if_sethide(grand_exchange_group_109:com_60, false);
if_sethide(grand_exchange_group_109:com_61, false);

