// Clicking an individual output collects only that output slot.
[inv_button1,grand_exchange_group_109:com_59]
~ge_collection_collect_slot(ge_collection_offer_0, last_slot);
if (inv_getobj(ge_collection_offer_0, last_slot) ! null) {
    mes("You don't have enough inventory space.");
}
~ge_collection_refresh_offer_0;

[inv_button1,grand_exchange_group_109:com_63]
~ge_collection_collect_slot(ge_collection_offer_1, last_slot);
if (inv_getobj(ge_collection_offer_1, last_slot) ! null) {
    mes("You don't have enough inventory space.");
}
~ge_collection_refresh_offer_1;

[inv_button1,grand_exchange_group_109:com_67]
