// The primary clerk from the frozen r481 reference (source NPC 6528).
// This file is present only in the option-2 Grand Exchange content stage.
// A type-specific spawn trigger replaces the generic NPC spawn trigger, so keep
// its standard initialization before fixing the stationary clerk's facing east.
[ai_spawn,grand_exchange_clerk]
%npc_combat_xp_multiplier = npc_param(combat_xp_multiplier);
%npc_start_coord = npc_coord;
npc_facesquare(movecoord(npc_coord, 1, 0, 0));

[opnpc1,grand_exchange_clerk]
~chatnpc("<p,neutral>Hello. How may I help you with the Grand Exchange?");

[opnpc2,grand_exchange_clerk]
~ge_open_collection_box;

[opnpc3,grand_exchange_clerk]
~ge_open_overview;

[opnpc4,grand_exchange_clerk]
~ge_open_history;

[opnpc5,grand_exchange_clerk]
mes("Item sets are not available in this Grand Exchange backport yet.");
